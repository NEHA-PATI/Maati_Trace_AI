# Recommended additions for .gitignore

# Secrets / local environment
backend/.env
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Virtual environments
backend/.venv/
.venv/
venv/
env/
ENV/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/

# Coverage outputs
.coverage
.coverage.*
htmlcov/
coverage.xml

# Logs
*.log
*.md
*.pdf
backend/services/*/.env
frontend/.env.local

# Crop observation service — farmer-uploaded media (local V1 storage).
# storage/system/ (admin-curated crop/stage images + audio) is committed.
backend/services/crop_observation_service/storage/farmer/
