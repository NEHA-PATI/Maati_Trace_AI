        "from pathlib import Path; from dotenv import load_dotenv; import runpy; env_path = Path('services/auth_service/.env'); assert env_path.is_file(), 'Missing services/auth_service/.env'; load_dotenv(env_path, override=True); runpy.run_module('services.auth_service.app.email_worker', run_name='__main__', alter_sys=True)"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
