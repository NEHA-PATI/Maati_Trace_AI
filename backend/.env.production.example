# ============================================================
# MaatiTrace Backend / Gateway - Production Configuration
# ============================================================

APP_ENV=production
LOG_LEVEL=INFO
PYTHONPATH=.

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=maati_trace_ai
POSTGRES_USER=maati_trace
POSTGRES_PASSWORD=CHANGE_ME

# Authentication cryptography
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_BYTE_SECRET
TOKEN_HMAC_SECRET=CHANGE_ME_TO_RANDOM_64_BYTE_SECRET
AUDIT_HMAC_SECRET=CHANGE_ME_TO_RANDOM_64_BYTE_SECRET
EMAIL_PAYLOAD_ENCRYPTION_KEY=CHANGE_ME_TO_A_VALID_FERNET_KEY

JWT_ALGORITHM=HS256
JWT_ISSUER=maatitrace-auth
JWT_AUDIENCE=maatitrace-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Browser origin that is allowed to talk to the gateway
CORS_ALLOWED_ORIGINS=https://app.maatitrace.com

# Private network service discovery
API_GATEWAY_SERVICE_URL=http://api-gateway-service:8000
AUTH_SERVICE_URL=http://auth-service:8002
BOUNDARY_INDEX_SERVICE_URL=http://boundary-index-service:8004
DISTRICT_BOUNDARY_SERVICE_URL=http://district-boundary-service:8005
FARM_REGISTRY_SERVICE_URL=http://farm-registry-service:8006
STAC_CATALOG_SERVICE_URL=http://stac-catalog-service:8007
RASTER_PROCESSOR_SERVICE_URL=http://raster-processor-service:8008
LAKEHOUSE_WRITER_SERVICE_URL=http://lakehouse-writer-service:8009
HOT_STREAM_ORCHESTRATOR_SERVICE_URL=http://hot-stream-orchestrator-service:8010
ANALYTICS_QUERY_SERVICE_URL=http://analytics-query-service:8011
