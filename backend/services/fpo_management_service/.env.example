# MaatiTrace FPO Management Service local/production contract.
# Keep this file separate from backend/.env and auth_service/.env.

APP_ENV=local
LOG_LEVEL=INFO
PYTHONPATH=.

# HTTP service
FPO_SERVICE_PORT=8016
FPO_CORS_ALLOWED_ORIGINS=http://localhost:5173
FPO_TRUSTED_HOSTS=localhost,127.0.0.1,fpo-management-service

# Shared database/JWT settings are intentionally repeated here for deployment
# isolation. Replace all CHANGE_ME values in a real environment.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=maati_trace_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_TO_THE_SAME_JWT_SECRET_USED_BY_AUTH
JWT_ALGORITHM=HS256
JWT_ISSUER=maatitrace-auth
JWT_AUDIENCE=maatitrace-web

# Outbox worker
FPO_OUTBOX_BATCH_SIZE=25
FPO_OUTBOX_POLL_SECONDS=5
