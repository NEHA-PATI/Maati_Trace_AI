# ============================================================
# MaatiTrace Auth Service - Production Configuration
# ============================================================

APP_ENV=production
LOG_LEVEL=INFO
PYTHONPATH=.

# PostgreSQL used by Auth Service
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=maati_trace_ai
POSTGRES_USER=maati_trace
POSTGRES_PASSWORD=CHANGE_ME

# Authentication cryptography
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_BYTE_SECRET
TOKEN_HMAC_SECRET=CHANGE_ME_TO_RANDOM_64_BYTE_SECRET
AUDIT_HMAC_SECRET=CHANGE_ME_TO_RANDOM_64_BYTE_SECRET
EMAIL_PAYLOAD_ENCRYPTION_KEY=CHANGE_ME_TO_A_VALID_FERNET_KEY

JWT_ALGORITHM=HS256
JWT_ISSUER=maatitrace-auth
JWT_AUDIENCE=maatitrace-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

PASSWORD_HASH_SCHEME=bcrypt

# Frontend origin and browser flow
FRONTEND_PUBLIC_URL=https://app.maatitrace.com
FRONTEND_PASSWORD_RESET_PATH=/reset-password
FRONTEND_INVITATION_ACCEPT_PATH=/accept-invitation

# CORS and host allow-list
CORS_ALLOWED_ORIGINS=https://app.maatitrace.com
TRUSTED_HOSTS=auth-service,localhost,127.0.0.1

# Secure browser cookies - gateway-only browser flow
REFRESH_COOKIE_NAME=maatitrace_refresh
REFRESH_COOKIE_PATH=/api/auth
CSRF_COOKIE_NAME=maatitrace_csrf
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Google OAuth
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_AUTO_LINK_VERIFIED_EMAIL=true

# Microsoft Graph mail
MAIL_ENABLED=true
MAIL_PROVIDER=microsoft_graph
MAIL_FROM_EMAIL=no-reply@maatitrace.com
MICROSOFT_TENANT_ID=CHANGE_ME
MICROSOFT_CLIENT_ID=CHANGE_ME
MICROSOFT_CLIENT_SECRET=CHANGE_ME
MICROSOFT_GRAPH_SCOPE=https://graph.microsoft.com/.default

# Email worker
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_POLL_SECONDS=3
EMAIL_WORKER_MAX_ATTEMPTS=6
EMAIL_WORKER_LOCK_TIMEOUT_SECONDS=300

# Signup OTP
SIGNUP_OTP_EXPIRE_MINUTES=10
SIGNUP_OTP_RESEND_COOLDOWN_SECONDS=60
SIGNUP_OTP_MAX_RESENDS=3
SIGNUP_OTP_MAX_ATTEMPTS=5

# Password recovery and invitations
PASSWORD_RESET_EXPIRE_MINUTES=30
INVITATION_EXPIRE_HOURS=72

# Breached-password checking
PWNED_PASSWORDS_ENABLED=true
PWNED_PASSWORDS_TIMEOUT_SECONDS=4
PWNED_PASSWORDS_FAIL_CLOSED=false
