APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FARM_REGISTRY_SERVICE_URL=http://localhost:8006

# PostgreSQL is read by shared.config.settings.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=maati_trace_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Required by shared.config.settings / shared.security.local_auth.
JWT_SECRET=replace-with-existing-auth-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=maatitrace-auth
JWT_AUDIENCE=maatitrace-web

# This service's own port (not read by shared.config.settings — passed to
# uvicorn directly, see docs/database_api_map.md for the port registry).
CROP_OBSERVATION_SERVICE_PORT=8015

# Media. V1 = LOCAL filesystem storage under storage/system (admin-curated
# images/audio) and storage/farmer (uploads) — no AWS setup needed. Flip to
# MEDIA_STORAGE_BACKEND=S3 + fill CROP_OBSERVATION_S3_BUCKET later; no DB or
# frontend change is required for that switch (see app/storage/).
MEDIA_STORAGE_BACKEND=LOCAL
LOCAL_MEDIA_ROOT=storage
LOCAL_SYSTEM_MEDIA_DIR=system
LOCAL_FARMER_MEDIA_DIR=farmer
DEFAULT_LOCALE=or-IN
ALLOWED_LOCALES=en-IN,or-IN

# No AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY here on purpose — only read when
# MEDIA_STORAGE_BACKEND=S3; boto3 then resolves an IAM role in production or
# AWS_PROFILE/credentials file locally.
CROP_OBSERVATION_S3_BUCKET=
S3_PRESIGNED_UPLOAD_TTL_SECONDS=300
S3_PRESIGNED_DOWNLOAD_TTL_SECONDS=300
MAX_IMAGES_PER_OWNER=2
MAX_IMAGE_BYTES=8388608
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
MAX_AUDIO_PER_OWNER=1
MAX_AUDIO_BYTES=6291456
MAX_AUDIO_DURATION_SECONDS=60
MAX_INSTRUCTION_AUDIO_DURATION_SECONDS=40
ALLOWED_AUDIO_MIME_TYPES=audio/webm,audio/ogg,audio/mp4,audio/mpeg,audio/wav,audio/x-wav
CARTESIA_TTS_ENABLED=true
CARTESIA_API_KEY=
CARTESIA_API_BASE=https://api.cartesia.ai
CARTESIA_API_VERSION=2026-08-14
CARTESIA_TTS_MODEL=sonic-3.6-2026-08-27
CARTESIA_ODIA_VOICE_ID=b2a31ee9-7373-4122-852d-eec9576e2fa6
CARTESIA_ENGLISH_VOICE_ID=
CARTESIA_TTS_OUTPUT_CONTAINER=mp3
CARTESIA_TTS_SPEED=0.95
CARTESIA_TTS_VOLUME=1.0
CARTESIA_CONNECT_TIMEOUT_SECONDS=5
CARTESIA_READ_TIMEOUT_SECONDS=30
