APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_SERVICE_URL=http://localhost:8002
PROFILE_SERVICE_URL=http://localhost:8003
DISTRICT_BOUNDARY_SERVICE_URL=http://localhost:8005
BOUNDARY_INDEX_SERVICE_URL=http://localhost:8004
PROFILE_INTERNAL_SERVICE_TOKEN=replace-with-profile-service-token
FARM_REGISTRY_INTERNAL_SERVICE_TOKEN=replace-with-farm-registry-internal-token
MAX_FARM_H3_CELLS=20000
MAX_POLYGON_VERTICES=500

# PostgreSQL is read by shared.config.settings.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=maati_trace_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Required by shared.config.settings.
JWT_SECRET=replace-with-existing-auth-secret
